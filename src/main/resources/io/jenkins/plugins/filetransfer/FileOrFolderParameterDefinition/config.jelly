<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Name}" field="name"><f:textbox /></f:entry>
  <f:entry title="${%Description}" field="description"><f:textarea /></f:entry>
  <f:entry title="${%Required}" field="required"><f:checkbox /></f:entry>
  <f:entry title="${%Maximum bytes}" field="maxBytes"><f:number min="0" /></f:entry>
  <f:entry title="${%Maximum files}" field="maxFiles"><f:number min="0" /></f:entry>
  <f:entry title="${%Allowed extensions}" field="allowedExtensionsText"><f:textbox /></f:entry>
  <f:entry title="${%Successful build retention days}" field="successRetentionDays"><f:number min="-1" /></f:entry>
  <f:entry title="${%Failed build retention days}" field="failureRetentionDays"><f:number min="-1" /></f:entry>
</j:jelly>
